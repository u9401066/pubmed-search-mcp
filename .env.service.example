# Copy the values into an untracked .env file or inject them from your secret
# manager. Never commit real API keys or bearer tokens.
NCBI_EMAIL=ops@example.org
NCBI_API_KEY=
PUBMED_AUTH_TOKENS=team-a:replace-with-a-long-random-token,team-b:replace-with-another-token
PUBMED_AUTH_RESOURCE_SERVER_URL=https://mcp.example.org/mcp
# Optional. Defaults to the public resource URL origin (for example https://mcp.example.org).
PUBMED_AUTH_ISSUER_URL=
PUBMED_ALLOWED_HOSTS=mcp.example.org
PUBMED_ALLOWED_ORIGINS=https://mcp.example.org
PUBMED_TRUSTED_PROXY_IPS=127.0.0.1
PUBMED_SERVICE_PORT=8765
PUBMED_TENANT_MAX_CONCURRENCY=8
PUBMED_SCHEDULER_ENABLED=false
